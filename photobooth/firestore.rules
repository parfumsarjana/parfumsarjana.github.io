rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function owner(uid) { return request.auth != null && request.auth.uid == uid; }

    // Isi tiap akun: pengaturan (dokumen owners/UID) dan template. Hanya pemilik akun.
    match /owners/{uid} {
      allow read, write: if owner(uid);
      match /templates/{t} { allow read, write: if owner(uid); }
    }

    // Signaling kamera iPhone, satu room per akun.
    match /rooms/{uid} {
      allow read, write: if owner(uid);
      match /candidates/{c} { allow read, write: if owner(uid); }
    }

    // Hasil foto: bisa dibuka siapa pun yang punya link (ID acak). Hanya akun login yang boleh membuat.
    match /results/{d} {
      allow read: if true;
      allow create: if request.auth != null && request.resource.data.owner == request.auth.uid;
      allow delete: if resource.data.created < request.time.toMillis() - 604800000;
    }
  }
}
