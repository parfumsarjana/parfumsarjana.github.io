rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /results/{f} {
      allow read: if true;
      allow create: if request.resource.size < 10 * 1024 * 1024 && request.resource.contentType == 'image/jpeg';
    }
    match /templates/{f} {
      allow read: if true;
      allow write: if request.auth != null && firestore.exists(/databases/(default)/documents/admins/$(request.auth.uid));
    }
  }
}
